# Copy this file to .env and fill in your real AdMob ad unit IDs.
# .env is kept out of git (.gitignore) but still uploaded to EAS Build
# (.easignore). Restart `npx expo start -c` after editing .env.

# true  = always use Google's test ads (safe while developing/testing)
# false = use the real ad unit IDs below
# Dev builds (__DEV__) always use test ads, and eas.json overrides this per
# build profile (development/preview = test, production = real).
EXPO_PUBLIC_USE_TEST_ADS=true

# Real AdMob ad unit IDs (AdMob console > Apps > Ad units)
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
