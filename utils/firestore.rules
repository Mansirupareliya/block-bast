// Paste this into Firebase console → Firestore Database → Rules → Publish.
//
// No Authentication is used anywhere in this app (by design — no login or
// signup screen for players). Each device writes to a doc keyed by a random
// id it generates itself (see utils/playerIdentity.js), so these rules can
// only validate the *shape* of the data, not who's allowed to write which
// doc — anyone who inspects network traffic could in principle overwrite
// another device's row. That's the accepted tradeoff for having zero
// auth/login UX; there's nothing sensitive in a name + score/level number.
//
// One collection per game: matchmakerLeaderboard (has maxLevel, since
// Matchmaker has discrete stages) and blockblastLeaderboard (score only,
// since Block Blast is endless). Add another `match` block the same shape
// if a third game gets a leaderboard later.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /matchmakerLeaderboard/{deviceId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name', 'maxLevel', 'bestScore', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.maxLevel is int
        && request.resource.data.maxLevel >= 0
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0;
    }

    match /blockblastLeaderboard/{deviceId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name', 'bestScore', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0;
    }
  }
}
